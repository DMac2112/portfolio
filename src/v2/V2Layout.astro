---
import '@fontsource-variable/host-grotesk';
import './v2.css';
---
<!doctype html>
<html lang="en" data-theme="carbon">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#3D22A8" />
    <!-- Carbon (dark) is the trial default; /v2/?theme=light shows the original light look for comparison. -->
    <script is:inline>
      const params = new URLSearchParams(location.search);
      if (params.get('theme') === 'light') document.documentElement.removeAttribute('data-theme');
      // TEMP: remove once Dominik picks a layout
      let savedLayout;
      try { savedLayout = localStorage.getItem('v2-layout'); } catch {}
      const layout = params.get('layout') ?? savedLayout;
      document.documentElement.dataset.layout = ['a', 'b', 'c', 'd'].includes(layout) ? layout : 'b';
      if ('registerProperty' in CSS) document.documentElement.classList.add('v2-sweep');
    </script>
    <title>Dominik Machowiak (v2 preview)</title>
  </head>
  <body>
    <slot />
    <script>import './v2.ts';</script>
  </body>
</html>
