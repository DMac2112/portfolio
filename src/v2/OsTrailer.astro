---
interface Props { hidden?: boolean }
const { hidden = false } = Astro.props;
const icons = [
  ['my-computer', 'My Computer'], ['folder-games', 'Games'], ['frostbyte', 'Frostbyte'],
  ['pinball', 'Pinball'], ['dialtone', 'Dialtone'], ['resume', 'Resume']
];
const classics = ['flappy', 'bubble', 'mines', 'pasjans', 'pajak', 'kierki', 'freecell'];
---
<div class="tr" role="img" aria-label="Animated preview: DominikOS boots to its desktop, then shows its games: Frostbyte, Space Pinball, my CV as a game, and seven classics." hidden={hidden}>
  <div class="tr-boot tr-scene" aria-hidden="true">
    <div class="tr-boot-centre">
      <img src="/os/ui/start-flag.svg" loading="lazy" decoding="async" alt="" />
      <strong>DominikOS</strong>
      <div class="tr-progress"><span></span><span></span><span></span></div>
    </div>
  </div>
  <div class="tr-welcome tr-scene" aria-hidden="true">
    <div class="tr-user"><img src="/os/ui/avatar.svg" loading="lazy" decoding="async" alt="" /><strong>Dominik</strong><i class="tr-ring"></i></div>
    <svg class="tr-cursor tr-welcome-cursor" viewBox="0 0 30 40"><path d="M2 2v31l8-8 5 12 5-3-5-11h12z" /></svg>
  </div>
  <div class="tr-desktop tr-scene" aria-hidden="true">
    <div class="tr-icons">
      {icons.map(([icon, label]) => <div class="tr-icon" data-icon={icon}><img src={`/os/icons/${icon}.svg`} loading="lazy" decoding="async" alt="" /><span>{label}</span><i class="tr-selection"></i></div>)}
    </div>
    <div class="tr-taskbar"><span class="tr-start"><img src="/os/ui/start-flag.svg" loading="lazy" decoding="async" alt="" /><b>start</b></span></div>
    <svg class="tr-cursor tr-desktop-cursor" viewBox="0 0 30 40"><path d="M2 2v31l8-8 5 12 5-3-5-11h12z" /></svg>
  </div>
  <div class="tr-games tr-scene" aria-hidden="true">
    <div class="tr-rays"></div><div class="tr-glow"></div>
    <h3 class="tr-games-title">{'Games!'.split('').map((letter) => <span>{letter}</span>)}</h3>
    <div class="tr-card" data-game="frostbyte">
      <div class="tr-art"><img src="/frostbyte/assets/room-plaza.jpg" loading="lazy" decoding="async" alt="" /><i class="tr-shine"></i></div>
      <strong class="tr-sticker">Frostbyte</strong><span class="tr-caption">Adopt a snowtail and explore a snowy town.</span><b class="tr-badge">NEW!</b>
    </div>
    <div class="tr-card" data-game="pinball">
      <div class="tr-art"><img src="/os/games/pinball/table-bg.jpg" loading="lazy" decoding="async" alt="" /><i class="tr-shine"></i></div>
      <strong class="tr-sticker">Space Pinball</strong><span class="tr-caption">Warps, beacons and a reactor bumper.</span>
    </div>
    <div class="tr-card" data-game="game1">
      <div class="tr-art tr-pixel"><img src="/os/icons/game1.svg" loading="lazy" decoding="async" alt="" /><i class="tr-shine"></i></div>
      <strong class="tr-sticker">My CV, as a game</strong><span class="tr-caption">Walk through my jobs in pixel form.</span>
    </div>
    <div class="tr-classics"><div class="tr-classic-icons">{classics.map((icon) => <img src={`/os/icons/${icon}.svg`} loading="lazy" decoding="async" alt="" />)}</div><strong>+ 7 classics, from Minesweeper to Spider Solitaire</strong></div>
    {Array.from({ length: 6 }, (_, i) => <i class="tr-sparkle" style={`--i:${i}`}></i>)}
  </div>
  <div class="tr-outro tr-scene" aria-hidden="true"><strong>Boot DominikOS to play</strong><i class="tr-outro-ring"></i></div>
  <button class="tr-toggle" type="button" hidden={false}>Pause preview</button>
</div>

<style>
  .tr { position: absolute; inset: 0; overflow: hidden; container-type: size; font-family: inherit; background: #000; isolation: isolate; }
  .tr[hidden] { display: none; }
  .tr * { box-sizing: border-box; }
  .tr-scene { position: absolute; inset: 0; overflow: hidden; opacity: 0; }
  .tr-boot { background: #000; color: white; opacity: 1; }
  .tr-boot-centre { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 2cqh; }
  .tr-boot-centre > img { width: 14cqw; height: 14cqw; }
  .tr-boot-centre > strong { font-size: 5cqw; font-weight: 650; }
  .tr-progress { position: relative; width: 22cqw; height: 1.8cqh; margin-top: 3cqh; border: 1px solid #5a5a5a; border-radius: 1cqh; overflow: hidden; }
  .tr-progress span { position: absolute; top: 15%; width: 2.5cqw; height: 70%; background: linear-gradient(90deg, #1740C9, #9CC8F4); border-radius: .4cqh; }
  .tr-welcome { background: #1740C9; color: white; }
  .tr-user { position: absolute; left: 37cqw; top: 37cqh; display: flex; align-items: center; gap: 2cqw; }
  .tr-user img { width: 13cqw; height: 13cqw; border: 3px solid white; border-radius: 1.4cqw; }
  .tr-user strong { font-size: 4.2cqw; font-weight: 600; }
  .tr-ring { position: absolute; left: 0; top: 0; width: 13cqw; height: 13cqw; border: .5cqw solid white; border-radius: 1.4cqw; opacity: 0; }
  .tr-cursor { position: absolute; width: 3cqw; height: 4cqw; fill: white; stroke: black; stroke-width: 1.5px; filter: drop-shadow(.2cqw .3cqw .1cqw #0006); }
  .tr-welcome-cursor { left: 89cqw; top: 84cqh; }
  .tr-desktop { background: #6ba9dd url('/os/wallpaper/hills.svg') center / cover no-repeat; }
  .tr-icons { position: absolute; top: 4cqh; left: 2cqw; display: grid; gap: 1.3cqh; }
  .tr-icon { position: relative; width: 12cqw; display: flex; align-items: center; flex-direction: column; gap: .4cqh; text-align: center; color: white; font-size: 1.9cqw; text-shadow: 1px 1px 2px #10264f, -1px -1px 2px #10264f; }
  .tr-icon img { width: 6cqw; height: 6cqw; object-fit: contain; }
  .tr-icon span { white-space: nowrap; }
  .tr-selection { position: absolute; inset: -.4cqh -.3cqw; border: 1px solid #b7d9ff; background: #3980dc66; opacity: 0; z-index: -1; }
  .tr-taskbar { position: absolute; bottom: 0; left: 0; right: 0; height: 7cqh; background: linear-gradient(#245EDC, #1941A5); }
  .tr-start { display: flex; align-items: center; gap: 1cqw; width: 15cqw; height: 100%; padding: 0 1.5cqw; color: white; background: #3AA53A; border-radius: 0 2cqh 2cqh 0; box-shadow: inset 0 .3cqh #ffffff55; }
  .tr-start img { width: 3.7cqw; height: 3.7cqw; }
  .tr-start b { font-size: 3.2cqw; font-style: italic; }
  .tr-desktop-cursor { left: 72cqw; top: 70cqh; }
  .tr-games { background: #1740C9; color: white; }
  .tr-rays { position: absolute; inset: -55%; background: repeating-conic-gradient(#1740C9 0deg 15deg, #2a55e0 15deg 30deg); }
  .tr-glow { position: absolute; inset: 0; background: radial-gradient(circle, #fff6 0, #fff0 53%); }
  .tr-games-title { position: absolute; top: 3cqh; left: 0; width: 100%; margin: 0; display: flex; justify-content: center; font-size: 9cqw; font-weight: 800; line-height: 1; color: white; -webkit-text-stroke: .6cqw #0E1A44; paint-order: stroke fill; }
  .tr-games-title span { display: inline-block; }
  .tr-card { position: absolute; top: 29cqh; left: 27cqw; width: 46cqw; height: 56cqh; text-align: center; opacity: 0; transform-origin: center; }
  .tr-art { position: relative; width: 46cqw; height: 30cqw; overflow: hidden; border: .8cqw solid white; border-radius: 3cqw; box-shadow: 0 0 0 .45cqw #0E1A44, 0 1.6cqw 0 #0E1A44; }
  .tr-art > img { width: 100%; height: 100%; object-fit: cover; }
  .tr-art.tr-pixel { display: flex; align-items: center; justify-content: center; background: #9CC8F4; }
  .tr-pixel > img { width: 16cqw; height: 16cqw; object-fit: contain; image-rendering: pixelated; }
  .tr-shine { position: absolute; inset: 0 0 55%; background: #ffffff47; border-radius: 2cqw 2cqw 50% 50%; }
  .tr-sticker { position: relative; display: inline-block; margin-top: 2.2cqh; padding: .6cqh 2cqw; background: #3AA53A; color: white; border: .35cqw solid #0E1A44; border-radius: .8cqw; font-size: 3.5cqw; font-weight: 700; transform: rotate(-3deg); white-space: nowrap; }
  .tr-caption { display: block; margin-top: 1.2cqh; font-size: 2.2cqw; font-weight: 600; white-space: nowrap; text-shadow: 1px 2px #0E1A44; }
  .tr-badge { position: absolute; top: -4cqh; right: -5cqw; width: 11cqw; height: 11cqw; display: grid; place-items: center; color: #0E1A44; background: #FFD23F; font-size: 2.4cqw; font-weight: 800; clip-path: polygon(50% 0,59% 16%,75% 7%,77% 26%,96% 24%,87% 41%,100% 50%,87% 59%,96% 76%,77% 74%,75% 93%,59% 84%,50% 100%,41% 84%,25% 93%,23% 74%,4% 76%,13% 59%,0 50%,13% 41%,4% 24%,23% 26%,25% 7%,41% 16%); }
  .tr-classics { position: absolute; left: 0; right: 0; bottom: 5cqh; text-align: center; opacity: 0; }
  .tr-classic-icons { display: flex; justify-content: center; gap: 2cqw; margin-bottom: 1cqh; }
  .tr-classic-icons img { width: 5.5cqw; height: 5.5cqw; }
  .tr-classics strong { font-size: 2.4cqw; font-weight: 600; }
  .tr-sparkle { position: absolute; left: calc(22cqw + var(--i) * 10cqw); top: calc(22cqh + var(--i) * 8cqh); width: 3cqw; height: 3cqw; background: white; clip-path: polygon(50% 0,60% 40%,100% 50%,60% 60%,50% 100%,40% 60%,0 50%,40% 40%); opacity: 0; }
  .tr-outro { display: grid; place-items: center; background: #1740C9; }
  .tr-outro strong { position: relative; z-index: 1; padding: 2cqh 3cqw; border: .5cqw solid #0E1A44; border-radius: 1cqw; background: #3AA53A; color: white; font-size: 4cqw; font-weight: 800; transform: rotate(-3deg); }
  .tr-outro-ring { position: absolute; width: 52cqw; height: 18cqh; border: 1cqw solid white; border-radius: 50%; opacity: 0; }
  .tr-toggle { position: absolute; z-index: 5; right: 1cqw; bottom: 1cqh; min-height: 32px; padding: 4px 8px; border: 0; border-radius: 4px; background: #ffffffe6; color: #0E1A44; font-family: inherit; font-size: .8rem; font-weight: 600; cursor: pointer; }
  .tr-toggle[hidden] { display: none; }
</style>