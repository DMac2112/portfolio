---
import { Image } from 'astro:assets';
import { contentImage, type WorkItem } from '../lib/content';
interface Props { works: WorkItem[]; }
const { works } = Astro.props;
---

<section id="work" class="section bg-primary" aria-labelledby="work-heading">
  <h2 id="work-heading" class="head-text">
    <span class="copy-heading" data-copy-version="current">My Current Development <span>Portfolio</span></span>
  </h2>
  <div class="project-showcase">
    <div class="project-controls" hidden>
      <div class="project-tabs" role="tablist" aria-labelledby="work-heading">
        {works.map((work, i) => (
          <button type="button" role="tab" id={`project-tab-${i}`} aria-controls={`project-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
            {work.title}<span class="tab-progress" aria-hidden="true"></span>
          </button>
        ))}
      </div>
      <button class="project-pause" type="button" aria-label="Pause automatic project rotation" aria-pressed="false"><span aria-hidden="true">Ⅱ</span></button>
    </div>
    {works.map((work, i) => (
      <article class="project-panel" id={`project-panel-${i}`} aria-labelledby={`project-title-${i}`}>
        <Image src={contentImage(work.image)} alt={`Screenshot of ${work.title}`} width={960} loading="lazy" decoding="async" />
        <div class="project-details">
          <div class="project-tags">{work.tags.map(tag => <span>{tag}</span>)}</div>
          <h3 id={`project-title-${i}`}>{work.title}</h3>
          <p>{work.description}</p>
          {work.projectLink && <a href={work.projectLink} target="_blank" rel="noreferrer noopener">Visit {work.title}</a>}
        </div>
      </article>
    ))}
  </div>
</section>
