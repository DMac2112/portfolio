---
// The lead quote is featured; remaining existing testimonials stay accessible.
import { Image } from 'astro:assets';
import { contentImage, type Testimonial } from '../lib/content';

interface Props {
  testimonials: Testimonial[];
}

const { testimonials } = Astro.props;
---

{testimonials.length > 0 && (
  <section id="testimonial" class="section bg-primary" aria-labelledby="testimonial-heading">
    <h2 id="testimonial-heading" class="head-text">
      <span class="copy-heading" data-copy-version="current">What people <span>say</span></span>

    </h2>

    <div class="t-stage">
      {testimonials.map((t, i) => (
        <figure class={i === 0 ? 'quote-panel' : 'sr-only'}>
          {i === 0 && <div class="panel-corners" aria-hidden="true"><i></i><i></i><i></i><i></i></div>}
          <blockquote>“{t.feedback}”</blockquote>
          <figcaption>
            <Image src={contentImage(t.image)} alt={`Portrait of ${t.name}`} width={40} height={40} loading="lazy" />
            <div><span class="t-name">{t.name}</span><span class="t-company">{t.company}</span></div>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>
)}

<style>
  .head-text > .copy-heading { color: inherit; }
  .t-stage { width: 100%; margin-top: 2.5rem; }
  .t-name { font-weight: 500; }
  .t-company { margin-top: .3125rem; font-size: var(--text-sm); }
</style>
